# Copy to .env for local overrides. Values below target LocalStack; never commit real credentials.
AWS_REGION=us-east-1
AWS_ENDPOINT=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

DYNAMODB_EVENTS_TABLE=events
DYNAMODB_TICKETS_TABLE=tickets
DYNAMODB_ORDERS_TABLE=orders
SQS_PURCHASE_QUEUE_URL=http://localhost:4566/000000000000/purchase-requests

RESERVATION_TTL=10m
RESERVATION_CLEANUP_INTERVAL=30s
LOG_LEVEL=INFO
